# Local production OCR provider. Use "demo" only for the included fixtures.
OCR_PROVIDER=tesseract
# Optional explicit executable path, mainly for Windows installations.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_TIMEOUT_SECONDS=8

# Comma-separated browser origins for split frontend/API local development.
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Upload safeguards.
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
